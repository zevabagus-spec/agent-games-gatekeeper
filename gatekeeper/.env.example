# HMAC secret issued when the endpoint is registered on agentgames.zkverify.io.
# REQUIRED. Never commit a real value; keep it in a local .env (gitignored)
# or in the deployment environment.
AGENT_GAMES_HMAC_SECRET=

# Optional overrides (defaults shown).
PORT=3000
HOST=0.0.0.0
SEEN_STORE_PATH=./data/seen.json
CIRCUIT_WASM_PATH=../circuits/gatekeeper.wasm
CIRCUIT_ZKEY_PATH=../circuits/gatekeeper_final.zkey
SOFT_BUDGET_MS=55000
MAX_BODY_BYTES=1048576
